<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no">
<meta name="theme-color" content="#12081f">

<title>Hoco? 💖</title>

<style>

*{
box-sizing:border-box;
-webkit-tap-highlight-color:transparent;
}

html,body{
margin:0;
width:100%;
height:100%;
overflow:hidden;
font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","Segoe UI",Roboto,sans-serif;
}

body{

background:
radial-gradient(circle at 20% 10%,#7b194f 0%,#32104d 40%,#12081f 100%);

color:white;

}

/* BACKGROUND GLOW */

.glow{
position:fixed;
width:280px;
height:280px;
border-radius:50%;
filter:blur(80px);
opacity:.35;
animation:drift 8s ease-in-out infinite alternate;
}

.g1{
background:#ff4f9a;
left:-80px;
top:-50px;
}

.g2{
background:#7c3aed;
right:-100px;
bottom:-60px;
animation-delay:-4s;
}

@keyframes drift{
to{
transform:translate(40px,-20px) scale(1.15);
}
}

/* SCREENS */

.screen{
position:fixed;
inset:0;
display:flex;
justify-content:center;
align-items:center;
padding:20px;
}

.hidden{
display:none;
}

/* CARD */

.card{

width:min(92vw,430px);

padding:30px 24px;

background:rgba(255,255,255,.08);

backdrop-filter:blur(25px);
-webkit-backdrop-filter:blur(25px);

border-radius:30px;

border:1px solid rgba(255,255,255,.15);

box-shadow:0 25px 60px rgba(0,0,0,.35);

text-align:center;

}

/* ENVELOPE */

.envelope{

font-size:78px;

animation:float 2.3s ease-in-out infinite;

}

@keyframes float{

50%{

transform:translateY(-10px) rotate(2deg);

}

}

h1{

margin:14px 0 10px;

font-size:40px;

letter-spacing:-1px;

}

p{

font-size:18px;

line-height:1.5;

opacity:.95;

}

.sub{

font-size:13px;

opacity:.7;

margin-top:18px;

}

/* BUTTONS */

button{

border:none;

cursor:pointer;

border-radius:999px;

font-size:17px;

font-weight:800;

padding:15px 30px;

transition:.2s;

}

button:active{

transform:scale(.95);

}

.primary{

background:white;

color:#e83d91;

box-shadow:0 12px 30px rgba(255,79,154,.3);

}

/* PROPOSAL */

.play{

position:relative;

height:240px;

margin-top:15px;

}

#yes{

position:absolute;

left:50%;

bottom:10px;

transform:translateX(-50%);

background:white;

color:#e83d91;

box-shadow:0 12px 30px rgba(255,255,255,.2);

}

#no{

position:absolute;

left:50%;

top:12px;

transform:translateX(-50%);

background:#17131e;

color:white;

border:1px solid rgba(255,255,255,.12);

touch-action:none;

}

.counter{

font-size:13px;

opacity:.7;

margin-top:10px;

}

/* HEARTS */

.heart{

position:fixed;

bottom:-30px;

font-size:22px;

pointer-events:none;

animation:rise linear forwards;

z-index:5;

}

@keyframes rise{

to{

transform:translateY(-110vh) rotate(30deg);

opacity:0;

}

}

/* CONFETTI */

.confetti{

position:fixed;

top:-20px;

width:10px;

height:18px;

border-radius:3px;

animation:fall linear forwards;

z-index:10;

}

@keyframes fall{

to{

transform:translate3d(var(--x),110vh,0) rotate(760deg);

opacity:.9;

}

}

/* SUCCESS */

.big{

font-size:76px;

}

</style>

</head>

<body>

<div class="glow g1"></div>
<div class="glow g2"></div>

<!-- INTRO -->

<section class="screen" id="intro">

<div class="card">

<div class="envelope">💌</div>

<h1>A little question...</h1>

<p>There's someone I'd really like to take to Homecoming.</p>

<button class="primary" id="openBtn">

Open 💖

</button>

<div class="sub">

Tap to open

</div>

</div>

</section>

<!-- PROPOSAL -->

<section class="screen hidden" id="proposal">

<div class="card">

<div style="font-size:34px;">🌸✨</div>

<h1>Vivian,</h1>

<p style="font-size:22px;font-weight:700;">

will you go to Homecoming with me?

</p>

<div class="play" id="playArea">

<button id="no">

No

</button>

<button id="yes">

YES 💖

</button>

</div>

<div class="counter">

No attempts: <span id="count">0</span>/25

</div>

</div>

</section>

<!-- YES -->

<section class="screen hidden" id="yesScreen">

<div class="card">

<div class="big">🎉</div>

<h1>LET'S GOOO!</h1>

<p>

Homecoming with you sounds perfect, Vivian 💖

</p>

<p class="sub">

Okay now we gotta plan the fit 😭

</p>

</div>

</section>

<!-- NO -->

<section class="screen hidden" id="noScreen">

<div class="card">

<div class="big">😔</div>

<h1>Dang...</h1>

<p>

You finally caught the No button after 25 attempts 😂

</p>

</div>

</section>

<script>

const intro=document.getElementById("intro");
const proposal=document.getElementById("proposal");
const yesScreen=document.getElementById("yesScreen");
const noScreen=document.getElementById("noScreen");

const openBtn=document.getElementById("openBtn");

const yesBtn=document.getElementById("yes");
const noBtn=document.getElementById("no");

const playArea=document.getElementById("playArea");

const counter=document.getElementById("count");

let attempts=0;

/* OPEN */

openBtn.onclick=()=>{

intro.classList.add("hidden");

proposal.classList.remove("hidden");

for(let i=0;i<15;i++){

setTimeout(createHeart,i*120);

}

};

/* HEARTS */

function createHeart(){

const heart=document.createElement("div");

heart.className="heart";

const hearts=["💖","💕","💗","✨","🌸"];

heart.textContent=hearts[Math.floor(Math.random()*hearts.length)];

heart.style.left=Math.random()*100+"vw";

heart.style.animationDuration=(3+Math.random()*2)+"s";

document.body.appendChild(heart);

setTimeout(()=>heart.remove(),5000);

}

/* DODGE */

function dodge(e){

e.preventDefault();

e.stopPropagation();

if(attempts>=25)return;

attempts++;

counter.textContent=attempts;

const maxX=playArea.clientWidth-noBtn.offsetWidth;

const maxY=playArea.clientHeight-noBtn.offsetHeight;

noBtn.style.left=Math.random()*maxX+"px";

noBtn.style.top=Math.random()*maxY+"px";

noBtn.style.transform="none";

if(navigator.vibrate){

navigator.vibrate(20);

}

if(attempts===25){

setTimeout(()=>{

proposal.classList.add("hidden");

noScreen.classList.remove("hidden");

},180);

}

}

["pointerdown","pointerenter","touchstart","click"].forEach(event=>{

noBtn.addEventListener(event,dodge,{passive:false});

});

/* YES */

yesBtn.onclick=()=>{

proposal.classList.add("hidden");

yesScreen.classList.remove("hidden");

launchConfetti();

for(let i=0;i<40;i++){

setTimeout(createHeart,i*70);

}

};

/* CONFETTI */

function launchConfetti(){

for(let i=0;i<180;i++){

const piece=document.createElement("div");

piece.className="confetti";

piece.style.left=Math.random()*100+"vw";

piece.style.setProperty("--x",(Math.random()*220-110)+"px");

piece.style.background=

`hsl(${Math.random()*360},95%,65%)`;

piece.style.animationDuration=

(2.2+Math.random()*2)+"s";

piece.style.animationDelay=

Math.random()*.4+"s";

document.body.appendChild(piece);

setTimeout(()=>piece.remove(),4500);

}

}

</script>

</body>
</html>